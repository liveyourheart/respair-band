---
import BaseLayout from '../layouts/BaseLayout.astro';
import StreamingLinks from '../components/StreamingLinks.astro';
import ContactForm from '../components/ContactForm.astro';
import '../styles/respair.css';
---

<BaseLayout
  title="Respair"
  description="Respair is an atmospheric emo crust band from Oklahoma City."
  ogImage="https://respair.band/images/preview.png"
  ogUrl="https://respair.band/"
>
  <img class="logo" src="/images/website-logo.png" alt="Respair" />

  <StreamingLinks
    links={[
      { url: 'https://music.apple.com/us/album/demo-2025-ep/1858472615', icon: '/images/apple-logo.png', id: 'apple' },
      { url: 'https://amomentofrespair.bandcamp.com/album/demo-2025-2', icon: '/images/bandcamp.png' },
      { url: 'https://www.instagram.com/a_moment_of_respair', icon: '/images/instagram.png' },
      { url: 'https://open.spotify.com/album/02VUgTNphFEAQ3bsFKbXjH?si=o9cpXsKBQpGzDswLn6Rs0Q', icon: '/images/spotify.png' },
      { url: 'https://www.youtube.com/watch?v=Ki7e_ppGh44&list=OLAK5uy_kQSh49Otdft_VY4WZcnLhAJBl191pep9A', icon: '/images/youtube.png', id: 'youtube' },
    ]}
  />

  <hr class="divider" />
  <hr class="divider" />

  <nav class="tab-nav">
    <a href="#band">Band</a>
    <a href="#shows">Shows</a>
    <a href="#press">Press</a>
    <a href="#contact">Contact</a>
  </nav>

  <hr class="divider" />
  <hr class="divider" />

  <!-- BAND -->
  <div id="tab-band" class="tab-section">
    <div class="band-content">
      <picture class="band-photo">
        <source srcset="/images/band-mobile.jpg" media="(max-width: 600px)" />
        <img src="/images/band-web.jpg" alt="Respair" />
      </picture>
      <div class="band-bio-block">
        <p class="band-bio">Based in Oklahoma City, Respair takes its name from an archaic term for "the return of hope after despair." The idea of recovering from despair is the backbone of the band's style — a heavy, intentional blend of atmospheric crust and emotional hardcore. Composed of friends and long-time members of the local DIY scene, the band draws on decades of collective experience to create music that is as aggressive as it is melodic.</p>
        <p class="band-bio">Lyrically, the band examines all aspects of life, from personal struggles and loss to growth, resilience, and redemption. Vocal performances range from hopeful and uplifting to dark and despondent, reflecting the emotional complexity of the human experience. This contrast gives Respair's music both weight and authenticity, resonating across a wide emotional spectrum.</p>
        <p class="band-bio">The band's values extend beyond music, embracing concerns surrounding human rights, animal welfare, and respect for underserved and marginalized communities. These perspectives inform their artistic vision and reinforce a belief in empathy, compassion, and collective responsibility.</p>
        <p class="band-bio">In 2025, they debuted with a self-recorded, self released demo, mmxxv, that navigates themes of perseverance and ancestral wisdom. For Respair, heavy music is a tool for endurance and a contribution to the local culture they've lived in for years. Whether performing at community benefit shows or crafting hypnotic, distorted hymns, the goal remains the same: finding a steady path forward through the darkness.</p>
      </div>
    </div>
  </div>

  <!-- SHOWS -->
  <div id="tab-shows" class="tab-section">
    <div class="shows" id="shows-list"></div>
  </div>

  <!-- PRESS -->
  <div id="tab-press" class="tab-section">
    <img class="press-photo" src="/images/press.jpg" alt="Respair" />
    <p class="press-quote">"Everything you're missing in your collection, and your life… reminiscent of From Ashes Rise, Tragedy, Remains of the Day, and early Neurosis."</p>
    <p class="press-attribution">
      — <a href="https://keepoklahomaheavy.substack.com" target="_blank" rel="noopener">Keep Oklahoma Heavy</a>
    </p>
    <a class="press-item" href="https://keepoklahomaheavy.substack.com/p/respair-the-return-of-hope" target="_blank" rel="noopener">Keep Oklahoma Heavy — Respair: The Return of Hope</a>
    <a class="press-item" href="http://youtube.com/watch?v=8F3NsEcNXrY&t=1712s" target="_blank" rel="noopener">Killing Time Podcast — Kill Murray</a>
    <!-- EPK: replace press-pending span with <a class="press-item" href="/press/epk.pdf">EPK</a> when file is ready -->
    <span class="press-pending">EPK coming soon</span>
    <!-- One sheet: replace press-pending span with <a class="press-item" href="/press/one-sheet.pdf">One Sheet</a> when file is ready -->
    <span class="press-pending">One Sheet coming soon</span>
    <p style="margin-top: 20px;">
      <a href="#contact" class="tab-link-contact">Contact us</a>
    </p>
  </div>

  <!-- CONTACT -->
  <div id="tab-contact" class="tab-section">

    <ContactForm
      accessKey="ea1405d3-0166-499a-9525-23b9e3b14187"
      subject="Respair Contact"
      redirectUrl="https://respair.band/?success=true"
    />
  </div>
</BaseLayout>

<script>
  // To add a show: push an entry to this array. slug matches the filename in src/pages/shows/.
  // Set slug to null for cancelled/postponed shows (renders as strikethrough + note).
  const shows = [
    { date: '2026-08-29', slug: '08292026', display: '08/29/2026 — Ft. Smith, AR — Hero\'s Irish Pub' },
    { date: '2026-05-16', slug: '05162026', display: '05/16/2026 — OKC — Resonant Head' },
    { date: '2026-04-18', slug: '04182026', display: '04/18/2026 — OKC — 89th Street' },
    { date: '2026-03-29', slug: '03292026', display: '03/29/2026 — OKC — Resonant Head' },
    { date: '2026-01-24', slug: null as string | null, display: '01/24/2026 — OKC — Resonant Head', note: 'rescheduled due to weather' },
    { date: '2025-12-07', slug: '12072025', display: '12/07/2025 — OKC — The Pet Shop' },
    { date: '2025-08-16', slug: '08162025', display: "08/16/2025 — OKC — Hooligan's" },
  ];

  function renderShows() {
    const container = document.getElementById('shows-list');
    if (!container) return;

    const today = new Date();
    today.setHours(0, 0, 0, 0);
    const toDate = (s: typeof shows[0]) => new Date(s.date + 'T00:00:00');

    const upcoming = shows
      .filter(s => toDate(s) >= today)
      .sort((a, b) => toDate(a).getTime() - toDate(b).getTime());

    const past = shows
      .filter(s => toDate(s) < today)
      .sort((a, b) => toDate(b).getTime() - toDate(a).getTime());

    const showEntry = (s: typeof shows[0]) => {
      if (s.slug) {
        return `<a class="show-link" href="/shows/${s.slug}/">${s.display}</a><br />`;
      }
      let out = `<span style="text-decoration: line-through; color: #555;">${s.display}</span><br />`;
      if (s.note) out += `<span style="color: #555; font-size: 0.7em; display: block; margin-top: 2px; margin-bottom: 10px;">${s.note}</span>`;
      return out;
    };

    let html = '';

    const nextShow = upcoming.find(s => s.slug);
    if (nextShow) {
      html += `<a href="/shows/${nextShow.slug}/"><img class="next-show-poster" src="/shows/${nextShow.slug}.jpg" alt="${nextShow.display}" /></a>`;
    }

    if (upcoming.length > 0) {
      html += '<h1>Upcoming</h1>' + upcoming.map(showEntry).join('');
    } else {
      html += '<p style="color: #555;">No upcoming shows. Check back soon.</p>';
    }

    if (past.length > 0) {
      html += '<h2>Past Shows</h2>' + past.map(showEntry).join('');
    }

    container.innerHTML = html;
  }

  renderShows();

  const validTabs = ['band', 'shows', 'press', 'contact'];

  function activateTab(name: string) {
    document.querySelectorAll('.tab-section').forEach((s) => {
      (s as HTMLElement).style.display = 'none';
    });
    document.querySelectorAll('.tab-nav a').forEach((a) => a.classList.remove('active'));
    const section = document.getElementById('tab-' + name);
    const link = document.querySelector(`.tab-nav a[href="#${name}"]`);
    if (section) section.style.display = 'block';
    if (link) link.classList.add('active');
  }

  // Activate on load
  const hash = window.location.hash.slice(1);
  activateTab(validTabs.includes(hash) ? hash : 'band');

  // Tab clicks and in-page tab links
  document.querySelectorAll('.tab-nav a, .tab-link-contact').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const name = (link as HTMLAnchorElement).getAttribute('href')!.slice(1);
      history.pushState(null, '', '#' + name);
      activateTab(name);
    });
  });

  // Browser back/forward
  window.addEventListener('popstate', () => {
    const h = window.location.hash.slice(1);
    activateTab(validTabs.includes(h) ? h : 'band');
  });
</script>
