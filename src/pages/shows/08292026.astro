---
import ShowLayout from '../../layouts/ShowLayout.astro';
import BandBlock from '../../components/BandBlock.astro';
---

<ShowLayout
  title="08-29-2026"
  description="Respair with Held Tight, Losing Game, Stressor, and Uncle Wizard at Hero's Irish Pub, Oklahoma City — August 29, 2026."
  poster="/shows/08292026.jpg"
  accentColor="#8a9a3a"
  bgColor="#0a0a0a"
  posterWidth="40%"
  posterWidthMobile="85%"
>
  <BandBlock
    name="HELD TIGHT"
    links={[
      { label: 'Bandcamp', url: 'https://heldtight.bandcamp.com/' },
      { label: 'Instagram', url: 'https://www.instagram.com/heldtight.ar/' },
    ]}
  />
  <BandBlock
    name="LOSING GAME"
    links={[
      { label: 'Instagram', url: 'https://www.instagram.com/losinggame479/' },
    ]}
  />
  <BandBlock
    name="STRESSOR"
    links={[
      { label: 'Bandcamp', url: 'https://stressor420.bandcamp.com/' },
      { label: 'Facebook', url: 'https://www.facebook.com/people/Stressor/61555553353888/' },
    ]}
  />
  <BandBlock
    name="RESPAIR"
    links={[
      { label: 'Website', url: '/' },
      { label: 'Instagram', url: 'https://www.instagram.com/a_moment_of_respair/' },
    ]}
  />
  <BandBlock
    name="UNCLE WIZARD"
    links={[
      { label: 'Instagram', url: 'https://www.instagram.com/unclewizardar/' },
    ]}
  />
  <BandBlock
    name="Hero's Irish Pub — Ft. Smith, AR"
    links={[]}
  />
  <BandBlock
    name="Tickets"
    links={[
      { label: '$10 // 21+ // 7:30PM', url: '' },
    ]}
  />
</ShowLayout>
